// Prisma schema - Sistem Manajemen Kursus & Absensi Almuna Samboja
// Dokumentasi: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Catatan: nilai-nilai berikut disimpan sebagai String dan divalidasi manual di controller.
// Role              : "ADMIN" | "TEACHER" | "STUDENT"
// Student.status    : "PENDING" | "APPROVED" | "REJECTED"
// AttendanceStatus  : "PRESENT" | "SICK" | "IZIN" | "ALPHA"
// GradeType         : "DAILY" | "MONTHLY"

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STUDENT")
  avatarUrl    String?  // foto profil - berlaku untuk semua role (admin, guru, siswa)
  createdAt    DateTime @default(now())

  // Relasi One-to-One ke Student (hanya terisi jika role = STUDENT)
  student      Student?

  @@map("users")
}

model Student {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  address     String
  parentPhone String   // nomor WA orang tua untuk notifikasi

  // Status persetujuan pendaftaran oleh admin
  status      String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"

  // Satu siswa bisa terdaftar di banyak kelas kursus (many-to-many lewat Enrollment)
  enrollments Enrollment[]

  attendances Attendance[]
  grades      Grade[]
  payments    Payment[]
  examAttempts ExamAttempt[]
  assessments Assessment[]

  createdAt   DateTime @default(now())

  @@map("students")
}

model Course {
  id                   Int       @id @default(autoincrement())
  name                 String
  description          String
  category             String    @default("Umum") // untuk pengelompokan tab di halaman admin
  fee                  Int       // biaya dalam Rupiah
  schedule             String    // contoh: "Senin - Jumat, 15.30 - 17.00"
  quota                Int?      // kuota peserta
  registrationDeadline DateTime? // tenggat pendaftaran
  createdAt            DateTime  @default(now())

  enrollments          Enrollment[]
  payments             Payment[]
  exams                Exam[]
  assessments          Assessment[]

  @@map("courses")
}

// Tabel penghubung: 1 siswa bisa ikut banyak kelas, 1 kelas bisa punya banyak siswa
model Enrollment {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([studentId, courseId]) // cegah siswa terdaftar dobel di kelas yang sama
  @@map("enrollments")
}

model GalleryPhoto {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())

  @@map("gallery_photos")
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  date      DateTime @default(now())
  status    String   // "PRESENT" | "SICK" | "ALPHA"
  notified  Boolean  @default(false) // apakah notifikasi WA berhasil dikirim
  timestamp DateTime @default(now())

  @@map("attendances")
}

model Grade {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  subject   String
  type      String   // "DAILY" | "MONTHLY"
  score     Float
  notes     String?  // keterangan tambahan tentang nilai ini (opsional)
  date      DateTime @default(now()) // tanggal nilai berlaku (bisa diedit, boleh beda dari tanggal input)
  createdAt DateTime @default(now()) // kapan entri ini benar-benar diinput (dipakai untuk daftar "hari ini")

  @@map("grades")
}

// Pembayaran SPP (biaya bulanan kursus) per siswa per kelas
model Payment {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    Int?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  amount      Int      // jumlah dibayar (Rupiah)
  periodMonth Int      // bulan SPP yang dibayar, 1-12
  periodYear  Int      // tahun SPP yang dibayar, contoh 2026
  paymentDate DateTime @default(now()) // tanggal pembayaran dilakukan
  method      String   // "CASH" | "TRANSFER"
  notes       String?  // keterangan tambahan (opsional)
  createdAt   DateTime @default(now())

  @@map("payments")
}

// Ujian online - soal disimpan sebagai file di Google Drive, kunci jawaban & hasil disimpan di sini
model Exam {
  id             Int       @id @default(autoincrement())
  title          String
  description    String?
  driveFileId    String    // ID file Google Drive yang berisi soal (PDF/gambar)
  driveFileName  String?   // nama file, untuk ditampilkan
  courseId       Int?
  course         Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  totalQuestions Int       // jumlah soal (menentukan jumlah baris kunci jawaban & form jawaban)
  durationMinutes Int?     // batas waktu pengerjaan (opsional, dalam menit)
  isPublished    Boolean   @default(false) // draft belum tampil ke siswa sampai dipublish
  createdAt      DateTime  @default(now())

  answerKeys     ExamAnswerKey[]
  attempts       ExamAttempt[]

  @@map("exams")
}

// Kunci jawaban per nomor soal
model ExamAnswerKey {
  id             Int    @id @default(autoincrement())
  examId         Int
  exam           Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionNumber Int
  correctAnswer  String // "A" | "B" | "C" | "D"

  @@unique([examId, questionNumber])
  @@map("exam_answer_keys")
}

// Satu kali pengerjaan ujian oleh siswa
model ExamAttempt {
  id             Int          @id @default(autoincrement())
  examId         Int
  exam           Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId      Int
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score          Float        // nilai 0-100
  correctCount   Int
  totalQuestions Int
  submittedAt    DateTime     @default(now())

  answers        ExamAnswer[]

  @@map("exam_attempts")
}

// Jawaban siswa per nomor soal dalam satu attempt
model ExamAnswer {
  id             Int         @id @default(autoincrement())
  attemptId      Int
  attempt        ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionNumber Int
  selectedAnswer String      // "A" | "B" | "C" | "D"
  isCorrect      Boolean

  @@map("exam_answers")
}

// Laporan penilaian bulanan per siswa: Speaking, Listening, Vocabulary, Reading, Grammar
// Biasanya dipakai untuk kelas Bahasa Inggris/Bahasa Arab. Satu baris = satu siswa, satu bulan.
model Assessment {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    Int?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  periodMonth Int      // 1-12
  periodYear  Int      // contoh 2026

  speaking    Float?   // nilai 0-100
  listening   Float?
  vocabulary  Float?
  reading     Float?
  grammar     Float?

  notes       String?  // catatan guru untuk bulan ini (opsional)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, periodMonth, periodYear]) // 1 siswa cuma 1 laporan per bulan
  @@map("assessments")
}
