# Port server backend
PORT=4000

# Database (SQLite untuk development, ganti ke PostgreSQL saat production)
# Contoh PostgreSQL: postgresql://user:password@localhost:5432/almuna_samboja
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="ganti_dengan_secret_key_yang_sangat_rahasia"
JWT_EXPIRES_IN="7d"

# WhatsApp API (Fonnte / WAPi / dsb) - isi saat production
WHATSAPP_API_KEY="isi_api_key_disini"
WHATSAPP_API_URL="https://api.fonnte.com/send"

# CORS - alamat frontend yang diizinkan
FRONTEND_URL="http://localhost:5173"
